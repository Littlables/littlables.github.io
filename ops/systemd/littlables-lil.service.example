[Unit]
Description=littlables local Lil API and development server
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=simple
User=katie
WorkingDirectory=/home/katie/repos/littlables.github.io
Environment=NODE_ENV=development
EnvironmentFile=-/home/katie/repos/littlables.github.io/.env
ExecStart=/home/katie/repos/littlables.github.io/scripts/start-lil-local.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
