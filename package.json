{
  "name": "littlables",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "tsc && vite build && rm -f assets/bundle*.js assets/bundle*.css assets/main*.js && mkdir -p assets && cp -r dist/assets/* assets/",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
