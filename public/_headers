# Always revalidate the HTML shell so new deploys are picked up immediately
# (/* covers SPA routes like /@username/... which serve index.html via _redirects)
/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed bundle assets are content-addressed — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable
